[Unit]
Description=CrashPilotX sign-off on clean shutdown
Documentation=https://crashpilotx.com/docs
# Started after the network, so systemd stops it (running ExecStop) before
# the network goes down and the sign-off can still reach the dashboard.
After=network-online.target
Wants=network-online.target
# Units stop in reverse start order: starting before everything that sends a
# heartbeat means those stop first, so no heartbeat lands after the sign-off
# and marks the machine online again.
Before=crashpilot-heartbeat.timer crashpilot-heartbeat.service crashpilot-update.timer crashpilot-update.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# Tells the dashboard to expect silence, so a clean shutdown, reboot, or
# scale-in shows as "Shut down cleanly" instead of an unexplained outage. The
# next heartbeat undoes it. Never fails the stop: sign-off always exits 0.
ExecStop=__CRASHPILOT_BIN__ sign-off --quiet
# A dead network must never hold up a shutdown.
TimeoutStopSec=8
# Files it creates (crash database, journal and dmesg caches) are private.
UMask=0077

[Install]
WantedBy=multi-user.target
