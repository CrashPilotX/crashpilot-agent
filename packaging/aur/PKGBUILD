# Maintainer: kdigitalsystems <noreply@kdigitalsystems.dev>
# AUR package for the CrashPilot agent (self-contained binary from GitHub Releases).
pkgname=crashpilot
pkgver=0.1.0
pkgrel=1
pkgdesc="AI-powered Linux crash forensics and root-cause analysis"
arch=('x86_64' 'aarch64')
url="https://github.com/kdigitalsystems/CrashPilot"
license=('MIT')
depends=()
optdepends=('smartmontools: SMART disk health telemetry'
            'lm_sensors: temperature telemetry')
backup=('etc/crashpilot/.env')
source_x86_64=("crashpilot-${pkgver}-x86_64::${url}/releases/download/v${pkgver}/crashpilot-linux-amd64")
source_aarch64=("crashpilot-${pkgver}-aarch64::${url}/releases/download/v${pkgver}/crashpilot-linux-arm64")
# Replace with real checksums from the release SHA256SUMS, or 'SKIP' for testing.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    # Binary
    install -Dm755 "${srcdir}/crashpilot-${pkgver}-$(uname -m)" "${pkgdir}/usr/bin/crashpilot"

    # systemd units (fetched from the repo at the matching tag)
    for unit in crashpilot.service crashpilot-heartbeat.service crashpilot-heartbeat.timer; do
        curl -sfL "${url}/raw/v${pkgver}/systemd/${unit}" \
            | sed 's|__CRASHPILOT_BIN__|/usr/bin/crashpilot|g; s|/usr/local/bin/crashpilot|/usr/bin/crashpilot|g' \
            > "${srcdir}/${unit}"
        install -Dm644 "${srcdir}/${unit}" "${pkgdir}/usr/lib/systemd/system/${unit}"
    done

    # Default config
    install -dm755 "${pkgdir}/etc/crashpilot"
    printf '# CrashPilot configuration\n# CRASHPILOT_ANTHROPIC_API_KEY=sk-ant-...  (optional; heuristics work without it)\n' \
        > "${pkgdir}/etc/crashpilot/.env"
    chmod 640 "${pkgdir}/etc/crashpilot/.env"
}
